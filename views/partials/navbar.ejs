<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About-FYR</title>
    <link rel="stylesheet" href="style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
      integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    /> <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
  <nav class="w-full bg-white shadow-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4">

    <!-- Logo -->
    <div class="flex items-center gap-3">
      <i class="fa-solid fa-kitchen-set text-3xl text-orange-500"></i>
      <h1 class="text-2xl font-bold text-gray-800">
        Tasty <span class="text-orange-500">Recipe</span>
      </h1>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-10">
      <a href="/index" class="text-gray-700 hover:text-orange-500 font-medium transition duration-300">
        Home
      </a>

      <a href="/about" class="text-gray-700 hover:text-orange-500 font-medium transition duration-300">
        About
      </a>

      <a href="/recipe" class="text-gray-700 hover:text-orange-500 font-medium transition duration-300">
        Recipes
      </a>
    </div>

    <!-- Desktop Button -->
    <div class="hidden md:block">
      <button
        onclick="window.location.href='/recipe'"
        class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-2 rounded-full font-semibold transition duration-300 shadow-md hover:shadow-lg cursor-pointer">
        Browse Recipes
      </button>
    </div>

    <!-- Mobile Menu Icon -->
    <button id="menuBtn" class="md:hidden text-2xl text-gray-700">
      <i class="fa-solid fa-bars-staggered"></i>
    </button>

  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="hidden md:hidden bg-white border-t">

    <a href="/"
      class="block px-6 py-4 hover:bg-orange-50 hover:text-orange-500 transition">
      Home
    </a>

    <a href="/about"
      class="block px-6 py-4 hover:bg-orange-50 hover:text-orange-500 transition">
      About
    </a>

    <a href="/recipe"
      class="block px-6 py-4 hover:bg-orange-50 hover:text-orange-500 transition">
      Recipes
    </a>

    <div class="p-4">
      <button
        onclick="window.location.href='/recipe'"
        class="w-full bg-orange-500 text-white py-3 rounded-full font-semibold hover:bg-orange-600 transition">
        Browse Recipes
      </button>
    </div>

  </div>
</nav>