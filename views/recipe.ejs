 <%- include('partials/navbar') %>
   <div class="max-w-6xl mx-auto px-6">

    <!-- Search -->
<form action="/recipe" method="post">
        <div class="flex flex-col md:flex-row gap-4 my-10">

        <input
            id="input-browse"
            type="text"
            name="search-Item"
            placeholder="What are we gonna cook today...?"
            class="flex-1 border border-gray-300 rounded-full px-6 py-4 focus:outline-none focus:ring-2 focus:ring-orange-400"
            />

        <button type="submit"
            id="search-button"
            class="bg-orange-500 text-white px-8 rounded-full hover:bg-orange-600 transition">
            Search
        </button>

    </div>
</form>

    <!-- Output -->
    <div id="recipeResult"
     class="bg-white rounded-2xl shadow-lg p-8 mb-12">

<% if(recipe){ %>

    <h2 class="text-3xl font-bold text-orange-500 mb-4">
        <%= recipe.strMeal %>
    </h2>

    <img
        src="<%= recipe.strMealThumb %>"
        class="w-full md:w-96 rounded-xl mb-6"
    >

    <div class="mb-5">
        <span class="font-bold">Category:</span>
        <%= recipe.strCategory %>
    </div>

    <div class="mb-5">
        <span class="font-bold">Cuisine:</span>
        <%= recipe.strArea %>
    </div>

    <div class="mb-5">
        <span class="font-bold">Tags:</span>
        <%= recipe.strTags || "None" %>
    </div>

    <h3 class="text-2xl font-semibold text-orange-500 mb-3">
        Ingredients
    </h3>

    <ul class="list-disc pl-6 mb-8">

        <% for(let i=1;i<=20;i++){ %>

            <% if(recipe["strIngredient"+i]){ %>

                <li>
                    <%= recipe["strIngredient"+i] %>
                    -
                    <%= recipe["strMeasure"+i] %>
                </li>

            <% } %>

        <% } %>

    </ul>

    <h3 class="text-2xl font-semibold text-orange-500 mb-3">
        Instructions
    </h3>

    <p class="leading-8 whitespace-pre-line">
        <%= recipe.strInstructions %>
    </p>

    <% if(recipe.strYoutube){ %>

        <div class="mt-8">

            <a
                href="<%= recipe.strYoutube %>"
                target="_blank"
                class="bg-red-500 text-white px-5 py-3 rounded-lg">

                Watch Recipe Video

            </a>

        </div>

    <% } %>

<% } else { %>

    <h2 class="text-3xl font-bold text-orange-500">
        Search a recipe 🍽️
    </h2>

<% } %>

</div>

</div>

      
         <%- include('partials/footer') %>

</body>
<script>
    let slides = document.querySelectorAll(".slides");
let current = 0;

function showSlide(index){

    slides.forEach(slide=>{
        slide.classList.add("hidden");
    });

    slides[index].classList.remove("hidden");
}

function nextSlide(){

    current++;

    if(current >= slides.length){
        current = 0;
    }

    showSlide(current);
}

showSlide(current);

setInterval(nextSlide,3000);
</script>
<script></script>
</html>