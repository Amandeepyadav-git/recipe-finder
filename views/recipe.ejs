 <%- include('partials/navbar') %>
   <div class="max-w-6xl mx-auto px-6">

    <!-- Search -->
<form action="/recipe" method="post">
        <div class="flex flex-col md:flex-row gap-4 my-10">

        <input
            id="input-browse"
            type="text"
            name="search-Item"
            placeholder="What are we gonna cook today...?"
            class="flex-1 border border-gray-300 rounded-full px-6 py-4 focus:outline-none focus:ring-2 focus:ring-orange-400"
            />

        <button type="submit"
            id="search-button"
            class="bg-orange-500 text-white px-8 rounded-full hover:bg-orange-600 transition">
            Search
        </button>

    </div>
</form>

    <!-- Output -->
    <div
        id="recipeResult"
        class="bg-white rounded-2xl shadow-lg p-8 mb-12">

        <h2 class="text-3xl font-bold text-orange-500 mb-6">
            Recipe
        </h2>

        <p
            id="summary"
            class="text-gray-700 leading-8 mb-8">
        </p>

        <ol
            id="stepsList"
            class="list-decimal pl-6 space-y-3 text-gray-600">
        </ol>

    </div>

</div>

    <div class="footer absolute bottom-0 w-full">
         <%- include('partials/footer') %>
    </div>
</body>
<script>
    let slides = document.querySelectorAll(".slides");
let current = 0;

function showSlide(index){

    slides.forEach(slide=>{
        slide.classList.add("hidden");
    });

    slides[index].classList.remove("hidden");
}

function nextSlide(){

    current++;

    if(current >= slides.length){
        current = 0;
    }

    showSlide(current);
}

showSlide(current);

setInterval(nextSlide,3000);
</script>
<script></script>
</html>